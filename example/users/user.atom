// Fields have types but no values.
group User {
    let age: Int
    var isAdmin: Bool
}

let maxAge = 120

fn describe(user: User) -> Int {
    return 1
}

impl User {
    // Groups can only be constructed inside their own `impl`, so other code
    // uses `User.new(...)`.
    static fn new(age: Int, isAdmin: Bool) -> User {
        return User { age: age, isAdmin: isAdmin }
    }

    // Methods can only reach each other through `self`.
    fn score() -> Int {
        return self.base().doubled()
    }

    // Fields are read with `.`.
    fn base() -> Int {
        return self.age + describe(user: self)
    }
}

// Any type can be extended, including those from the standard library.
impl Int {
    fn doubled() -> Int {
        return self * 2
    }

    // Static functions are called on the type, as in `Int.zero()`.
    static fn zero() -> Int {
        return 0
    }
}
