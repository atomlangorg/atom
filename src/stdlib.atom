// The standard library. Every program can use these names without importing
// them.

// Whole numbers, such as `42`.
struct Int {}

// `true` or `false`.
struct Bool {}

// The return type of a function that doesn't return anything useful.
// Functions without an explicit return type return `Void`.
struct Void {}
