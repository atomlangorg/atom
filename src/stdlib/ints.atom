// A signed integer as wide as a pointer on the computer the program is built
// for, such as 64 bits on a 64-bit CPU. It's a different type from the integer
// of that width, such as `IntS64`, so code using it works the same on every
// CPU. `Int` is this type.
primitive IntS

impl IntS with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

impl IntS with Compare {
    fn compare(to rhs: Self) -> Comparison {
        if self < rhs {
            return .less.new()
        }
        if self > rhs {
            return .greater.new()
        }
        return .equal.new()
    }

    primitive fn isLess(than rhs: Self) -> Bool
    primitive fn isLessOrEqual(to rhs: Self) -> Bool
    primitive fn isGreater(than rhs: Self) -> Bool
    primitive fn isGreaterOrEqual(to rhs: Self) -> Bool
}

impl IntS with Add {
    primitive fn add(_ rhs: Self) -> Self
}

impl IntS with Subtract {
    primitive fn subtract(_ rhs: Self) -> Self
}

impl IntS with Multiply {
    primitive fn multiply(by rhs: Self) -> Self
}

impl IntS with Divide {
    primitive fn divide(by rhs: Self) -> Self
}

impl IntS with Negate {
    primitive fn negate() -> Self
}

impl IntS with BitAnd {
    primitive fn bitAnd(_ rhs: Self) -> Self
}

impl IntS with BitOr {
    primitive fn bitOr(_ rhs: Self) -> Self
}

impl IntS with BitXor {
    primitive fn bitXor(_ rhs: Self) -> Self
}

impl IntS with BitNot {
    primitive fn bitNot() -> Self
}
