// The standard library. Every program can use these names without importing
// them.

// Whole numbers, such as `42`. Unsigned integers (`IntU`) hold 0 to 2^N - 1,
// and signed integers (`IntS`) hold -2^(N-1) to 2^(N-1) - 1, where N is the
// number of bits. Arithmetic that goes outside a type's range stops the
// program. Only unsigned integers can be shifted, with `.<` and `.>`, which
// stop the program if the amount isn't from 0 to N - 1, or if `.<` shifts
// off a `1`.
primitive IntU8
primitive IntU16
primitive IntU32
primitive IntU64
primitive IntS8
primitive IntS16
primitive IntS32
primitive IntS64

// The integer to use unless another is needed. Integer literals are `Int`s
// unless they're used as another integer type.
alias Int = IntS64

// `true` or `false`.
primitive Bool

// The return type of a function that doesn't return anything useful.
// Functions without an explicit return type return `Void`.
group Void {}

impl Void {
    // Creates a `Void`, for when one is needed as a value.
    static fn new() -> Void {
        return Void {}
    }
}

// A value that can never exist, since it has no options to create it from. A
// function with a `Never` parameter can never be called, and a `match` on a
// `Never` has no options to match.
choice Never {}

// Stops the program immediately with exit code 1. It never finishes, so a
// call to it ends its path through a function like a `return` would.
primitive fn exit() -> Never

// Types that `&` can be used on, which calls `and`, as in `a & b`, where `b`
// is an `Rhs`, and the result is an `Output`.
trait And {
    alias Rhs
    alias Output

    fn and(_ rhs: Rhs) -> Output
}

// Types that `|` can be used on, which calls `or`, as in `a | b`, where `b` is
// an `Rhs`, and the result is an `Output`.
trait Or {
    alias Rhs
    alias Output

    fn or(_ rhs: Rhs) -> Output
}

// Types that `!` can be used on, which calls `not`, as in `!a`, where the
// result is an `Output`.
trait Not {
    alias Output

    fn not() -> Output
}

// Types that `==` and `!=` can be used on, which call `isEqual` and
// `isNotEqual`, as in `a == b`, where `b` is an `Rhs`. `isNotEqual` is the
// opposite of `isEqual` unless it's implemented too.
trait Equal {
    alias Rhs

    fn isEqual(to rhs: Rhs) -> Bool

    fn isNotEqual(to rhs: Rhs) -> Bool {
        return !self.isEqual(to: rhs)
    }
}

// Each `impl` infers its trait's aliases from its signatures, such as
// `alias Rhs = Self` and `alias Output = Bool` from `and`.
impl Bool with And {
    // `true` if both are `true`.
    primitive fn and(_ rhs: Self) -> Bool
}

impl Bool with Or {
    // `true` if either is `true`.
    primitive fn or(_ rhs: Self) -> Bool
}

impl Bool with Not {
    // `true` if it's `false`, and `false` if it's `true`.
    primitive fn not() -> Bool
}

// Integers and `Bool`s are equal if they hold the same value.
impl IntU8 with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

impl IntU16 with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

impl IntU32 with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

impl IntU64 with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

impl IntS8 with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

impl IntS16 with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

impl IntS32 with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

impl IntS64 with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

impl Bool with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

// Types whose values can be called like functions, which calls `call`, as in
// `adder(a: 3, b: 5)` for `adder.call(input: (a: 3, b: 5))`. The arguments
// are the `Input`, written like a tuple without its brackets.
trait Call {
    alias Input
    alias Output

    fn call(input: Input) -> Output
}
