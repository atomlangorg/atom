// The standard library. Every program can use these names without importing
// them.

use ./builtin

// Whole numbers, such as `42`.
group Int {
    let builtin: builtin::Int
}

// `true` or `false`.
group Bool {
    let builtin: builtin::Bool
}

// The return type of a function that doesn't return anything useful.
// Functions without an explicit return type return `Void`.
group Void {}

impl Void {
    // Creates a `Void`, for when one is needed as a value.
    static fn new() -> Void {
        return Void {}
    }
}

// A value that can never exist, since it has no options to create it from. A
// function with a `Never` parameter can never be called, and a `match` on a
// `Never` has no options to match.
choice Never {}
