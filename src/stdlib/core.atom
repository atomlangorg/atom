// The standard library. Every program can use these names without importing
// them.

// Whole numbers, such as `42`. Unsigned integers (`IntU`) hold 0 to 2^N - 1,
// and signed integers (`IntS`) hold -2^(N-1) to 2^(N-1) - 1, where N is the
// number of bits. Arithmetic that goes outside a type's range stops the
// program, and so does dividing by zero. Only signed integers can be negated,
// and only unsigned integers can be shifted, with `.<` and `.>`, by an `Int`,
// which stops the program if the amount isn't from 0 to N - 1, or if `.<`
// shifts off a `1`.
primitive IntU8
primitive IntU16
primitive IntU32
primitive IntU64
primitive IntS8
primitive IntS16
primitive IntS32
primitive IntS64

// The integer to use unless another is needed. Integer literals are `Int`s
// unless they're used as another integer type.
alias Int = IntS64

// `true` or `false`.
primitive Bool

// The return type of a function that doesn't return anything useful.
// Functions without an explicit return type return `Void`.
group Void {}

impl Void {
    // Creates a `Void`, for when one is needed as a value.
    static fn new() -> Void {
        return Self {}
    }
}

// A value that can never exist, since it has no options to create it from. A
// function with a `Never` parameter can never be called, and a `match` on a
// `Never` has no options to match.
choice Never {}

// Stops the program immediately with exit code 1. It never finishes, so a
// call to it ends its path through a function like a `return` would.
primitive fn exit() -> Never

// Types that `&` can be used on, which calls `and`, as in `a & b`, where `b`
// is an `Rhs`, and the result is an `Output`.
trait And {
    alias Rhs
    alias Output

    fn and(_ rhs: Rhs) -> Output
}

// Types that `|` can be used on, which calls `or`, as in `a | b`, where `b` is
// an `Rhs`, and the result is an `Output`.
trait Or {
    alias Rhs
    alias Output

    fn or(_ rhs: Rhs) -> Output
}

// Types that `!` can be used on, which calls `not`, as in `!a`, where the
// result is an `Output`.
trait Not {
    alias Output

    fn not() -> Output
}

// Types that `==` and `!=` can be used on, which call `isEqual` and
// `isNotEqual`, as in `a == b`, where `b` is an `Rhs`. `isNotEqual` is the
// opposite of `isEqual` unless it's implemented too.
trait Equal {
    alias Rhs

    fn isEqual(to rhs: Rhs) -> Bool

    fn isNotEqual(to rhs: Rhs) -> Bool {
        return !self.isEqual(to: rhs)
    }
}

// Types that `<`, `<=`, `>` and `>=` can be used on, which call `isLess`,
// `isLessOrEqual`, `isGreater` and `isGreaterOrEqual`, as in `a < b`, where `b`
// is an `Rhs`.
trait Order {
    alias Rhs

    fn isLess(than rhs: Rhs) -> Bool
    fn isLessOrEqual(to rhs: Rhs) -> Bool
    fn isGreater(than rhs: Rhs) -> Bool
    fn isGreaterOrEqual(to rhs: Rhs) -> Bool
}

// Types that `+` can be used on, which calls `add`, as in `a + b`, where `b`
// is an `Rhs`, and the result is an `Output`.
trait Add {
    alias Rhs
    alias Output

    fn add(_ rhs: Rhs) -> Output
}

// Types that `-` can be used on, which calls `subtract`, as in `a - b`, where `b`
// is an `Rhs`, and the result is an `Output`.
trait Subtract {
    alias Rhs
    alias Output

    fn subtract(_ rhs: Rhs) -> Output
}

// Types that `*` can be used on, which calls `multiply`, as in `a * b`, where `b`
// is an `Rhs`, and the result is an `Output`.
trait Multiply {
    alias Rhs
    alias Output

    fn multiply(by rhs: Rhs) -> Output
}

// Types that `/` can be used on, which calls `divide`, as in `a / b`, where `b`
// is an `Rhs`, and the result is an `Output`.
trait Divide {
    alias Rhs
    alias Output

    fn divide(by rhs: Rhs) -> Output
}

// Types that `.&` can be used on, which calls `bitAnd`, as in `a .& b`, where `b`
// is an `Rhs`, and the result is an `Output`.
trait BitAnd {
    alias Rhs
    alias Output

    fn bitAnd(_ rhs: Rhs) -> Output
}

// Types that `.|` can be used on, which calls `bitOr`, as in `a .| b`, where `b`
// is an `Rhs`, and the result is an `Output`.
trait BitOr {
    alias Rhs
    alias Output

    fn bitOr(_ rhs: Rhs) -> Output
}

// Types that `.^` can be used on, which calls `bitXor`, as in `a .^ b`, where `b`
// is an `Rhs`, and the result is an `Output`.
trait BitXor {
    alias Rhs
    alias Output

    fn bitXor(_ rhs: Rhs) -> Output
}

// Types that `.<` can be used on, which calls `shiftLeft`, as in `a .< b`, where `b`
// is an `Rhs`, and the result is an `Output`.
trait ShiftLeft {
    alias Rhs
    alias Output

    fn shiftLeft(by amount: Rhs) -> Output
}

// Types that `.>` can be used on, which calls `shiftRight`, as in `a .> b`, where `b`
// is an `Rhs`, and the result is an `Output`.
trait ShiftRight {
    alias Rhs
    alias Output

    fn shiftRight(by amount: Rhs) -> Output
}

// Types that `-` can be used on before a value, which calls `negate`, as in
// `-a`, where the result is an `Output`.
trait Negate {
    alias Output

    fn negate() -> Output
}

// Types that `.!` can be used on before a value, which calls `bitNot`, as in
// `.!a`, where the result is an `Output`.
trait BitNot {
    alias Output

    fn bitNot() -> Output
}

// Each `impl` infers its trait's aliases from its signatures, such as
// `alias Rhs = Self` and `alias Output = Bool` from `and`. `Bool`s are equal if
// they hold the same value.
impl Bool with And {
    // `true` if both are `true`.
    primitive fn and(_ rhs: Self) -> Bool
}

impl Bool with Or {
    // `true` if either is `true`.
    primitive fn or(_ rhs: Self) -> Bool
}

impl Bool with Not {
    // `true` if it's `false`, and `false` if it's `true`.
    primitive fn not() -> Bool
}

impl Bool with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

