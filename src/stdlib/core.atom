// Types whose values can be called like functions, which calls `call`, as in
// `adder(a: 3, b: 5)` for `adder.call(input: (a: 3, b: 5))`. The arguments
// are always built into a tuple, which must be the `Input`, so a tuple is
// never unpacked into them. A `ChoiceOption` always has one argument, which
// is its `Input`, even if that's a tuple.
trait Call {
    alias Input
    alias Output

    fn call(input: Input) -> Output
}

// A function, which is what naming a function or static function refers to
// when it's used as a value, as in `add` or `Int.zero`. `Input` is a tuple of
// its parameters, as in `Fn<(a: Int, b: Int), Int>` for
// `fn add(a: Int, b: Int) -> Int`, or `Fn<(_: Int), Int>` for
// `fn negate(_ value: Int) -> Int`. A function called by name is called
// directly, and as a value it uses `Call`, so `adder(a: 3, b: 5)`, where
// `adder` is `add`, is `adder.call(input: (a: 3, b: 5))`.
primitive Fn<Input, Output>

impl Fn with Call {
    primitive fn call(input: Self.Input) -> Self.Output
}

// Which option of the choice `Base` something is, as in `ChoiceTag<Shape>`.
// `Base` must be a choice. Tags are equal if they're for the same option.
primitive ChoiceTag<Base>

impl ChoiceTag {
    // Creates the tag of the option that `value` is.
    static primitive fn new(of value: Self.Base) -> Self
}

impl ChoiceTag with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

// An option of the choice `Base` that holds a `Value`, which is what naming an
// option refers to, as in `Shape.circle`. `Base` must be a choice. Calling it
// creates the choice, so `Shape.circle(3)` is `Shape.circle.call(input: 3)`,
// and if `Value` is `Void` it can be left out, so `Shape.empty()` is
// `Shape.empty(Void.new())`.
primitive ChoiceOption<Base, Value>

impl ChoiceOption {
    primitive fn tag() -> ChoiceTag<Self.Base>
}

impl ChoiceOption with Call {
    primitive fn call(input: Self.Value) -> Self.Base
}
