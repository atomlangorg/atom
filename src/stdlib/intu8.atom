// An unsigned integer of 8 bits, which holds 0 to 255.
primitive IntU8

impl IntU8 with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}

impl IntU8 with Compare {
    fn compare(to rhs: Self) -> Comparison {
        if self < rhs {
            return Comparison.less.new(())
        }
        if self > rhs {
            return Comparison.greater.new(())
        }
        return Comparison.equal.new(())
    }

    primitive fn isLess(than rhs: Self) -> Bool
    primitive fn isLessOrEqual(to rhs: Self) -> Bool
    primitive fn isGreater(than rhs: Self) -> Bool
    primitive fn isGreaterOrEqual(to rhs: Self) -> Bool
}

impl IntU8 with Add {
    primitive fn add(_ rhs: Self) -> Self
}

impl IntU8 with Subtract {
    primitive fn subtract(_ rhs: Self) -> Self
}

impl IntU8 with Multiply {
    primitive fn multiply(by rhs: Self) -> Self
}

impl IntU8 with Divide {
    primitive fn divide(by rhs: Self) -> Self
}

impl IntU8 with BitAnd {
    primitive fn bitAnd(_ rhs: Self) -> Self
}

impl IntU8 with BitOr {
    primitive fn bitOr(_ rhs: Self) -> Self
}

impl IntU8 with BitXor {
    primitive fn bitXor(_ rhs: Self) -> Self
}

impl IntU8 with ShiftLeft {
    primitive fn shiftLeft(by amount: Int) -> Self
}

impl IntU8 with ShiftRight {
    primitive fn shiftRight(by amount: Int) -> Self
}

impl IntU8 with BitNot {
    primitive fn bitNot() -> Self
}
