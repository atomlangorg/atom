// `true` or `false`.
primitive Bool

// Each `impl` infers its trait's aliases from its signatures, such as
// `alias Rhs = Self` and `alias Output = Bool` from `and`. `Bool`s are equal if
// they hold the same value.
impl Bool with And {
    // `true` if both are `true`.
    primitive fn and(_ rhs: Self) -> Bool
}

impl Bool with Or {
    // `true` if either is `true`.
    primitive fn or(_ rhs: Self) -> Bool
}

impl Bool with Not {
    // `true` if it's `false`, and `false` if it's `true`.
    primitive fn not() -> Bool
}

impl Bool with Equal {
    primitive fn isEqual(to rhs: Self) -> Bool
    primitive fn isNotEqual(to rhs: Self) -> Bool
}
