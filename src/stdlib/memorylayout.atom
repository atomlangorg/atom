// How values of `Value` are laid out in memory, as in
// `MemoryLayout<Int>.size()`. It has no values of its own, since it's only
// for its static functions. The compiler decides each type's layout, so it
// can differ between computers, such as `Int` being 8 bytes on a 64-bit
// computer and 4 on a 32-bit one.
choice MemoryLayout<Value> {}

impl MemoryLayout {
    // How many bytes a `Value` takes up, not counting any padding after it
    // to keep the next one aligned.
    static primitive fn size() -> IntU

    // How many bytes apart the starts of `Value`s are when they're next to
    // each other in memory, which is `size` rounded up to a multiple of
    // `alignment`.
    static primitive fn stride() -> IntU

    // The number of bytes that the address of a `Value` is always a multiple
    // of, which is a power of 2.
    static primitive fn alignment() -> IntU
}
